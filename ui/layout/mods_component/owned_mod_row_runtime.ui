owned_mod_row:color {
  width: 758px;
  height: 52px;
  ignore_event: true;
  stroke: 1;
  back_color: #1d1f2cff;

  #owned_row_name:label {
    @"asset/base/style/main#label";
    x: 12px;
    width: 268px;
    height: 52px;
    size: 15;
    align_x: Left;
    align_y: Center;
    text: "";
  }
  #owned_row_author:label {
    @"asset/base/style/main#label";
    x: 292px;
    width: 154px;
    height: 52px;
    size: 14;
    align_x: Left;
    align_y: Center;
    text: "";
  }
  #owned_row_source:label {
    @"asset/base/style/main#label";
    x: 446px;
    width: 80px;
    height: 52px;
    size: 12;
    align_x: Center;
    align_y: Center;
    text: "";
  }
  #owned_toggle_track:empty {
    x: 532px;
    y: 7px;
    width: 217px;
    height: 38px;
    ignore_event: true;
    #owned_toggle_base:color {
      width: 172px;
      height: 38px;
      ignore_event: true;
      stroke: 1;
      back_color: #00000000;
    }
    #owned_toggle_thumb_0:color {
      x: 4px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #145648ff;
    }
    #owned_toggle_thumb_1:color {
      x: 14px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #145648ff;
    }
    #owned_toggle_thumb_2:color {
      x: 25px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #145648ff;
    }
    #owned_toggle_thumb_3:color {
      x: 35px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #145648ff;
    }
    #owned_toggle_thumb_4:color {
      x: 45px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #20223000;
    }
    #owned_toggle_thumb_5:color {
      x: 55px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #4a171cff;
    }
    #owned_toggle_thumb_6:color {
      x: 66px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #4a171cff;
    }
    #owned_toggle_thumb_7:color {
      x: 76px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #4a171cff;
    }
    #owned_toggle_thumb_8:color {
      x: 86px;
      y: 4px;
      width: 82px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #4a171cff;
    }
    #owned_enabled:color {
      x: 4px;
      y: 4px;
      width: 82px;
      height: 30px;
      ignore_event: true;
      stroke: 1;
      back_color: #145648ff;
      #label:label {
        @"asset/base/style/main#bold_label";
        width: 82px;
        height: 30px;
        size: 13;
        align_x: Center;
        align_y: Center;
        text: "Enabled";
      }
    }
    #owned_disabled:color {
      x: 86px;
      y: 4px;
      width: 82px;
      height: 30px;
      ignore_event: true;
      stroke: 1;
      back_color: #145648ff;
      #label:label {
        @"asset/base/style/main#bold_label";
        width: 82px;
        height: 30px;
        size: 13;
        align_x: Center;
        align_y: Center;
        text: "Disabled";
      }
    }
    #owned_status_slot:color {
      x: 184px;
      y: 4px;
      width: 30px;
      height: 30px;
      visible: false;
      ignore_event: true;
      stroke: 1;
      back_color: #171822ff;
      #owned_status_restart:image {
        x: 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        visible: false;
        ignore_event: true;
        source: "asset/mod_menu/ui/icons/status-restart";
      }
      #owned_status_update:image {
        x: 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        visible: false;
        ignore_event: true;
        source: "asset/mod_menu/ui/icons/status-update";
      }
      #owned_status_warning:image {
        x: 3px;
        y: 3px;
        width: 22px;
        height: 22px;
        visible: false;
        ignore_event: true;
        source: "asset/mod_menu/ui/icons/status-warning";
      }
    }
