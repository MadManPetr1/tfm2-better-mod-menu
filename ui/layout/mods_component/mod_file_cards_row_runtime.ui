bmm_file_cards_row:color {
  width: 694px;
  height: 118px;
  ignore_event: true;
  stroke: 1;
  back_color: #1d1f2cff;

  #bmm_setting_label:label {
    @"asset/base/style/main#bold_label";
    x: 14px;
    y: 8px;
    width: 666px;
    height: 22px;
    size: 14;
    align_x: Left;
    align_y: Center;
    text: "Backups";
  }

  #bmm_setting_description:label {
    @"asset/base/style/main#label";
    x: 14px;
    y: 31px;
    width: 666px;
    height: 20px;
    size: 12;
    align_x: Left;
    align_y: Center;
    text: "Select a verified backup to import.";
  }

  #bmm_setting_file_empty:label {
    @"asset/base/style/main#label";
    x: 14px;
    y: 60px;
    width: 666px;
    height: 40px;
    size: 12;
    align_x: Center;
    align_y: Center;
    text: "No verified backups yet";
  }

  #bmm_setting_file_card_0:color {
    x: 14px;
    y: 60px;
    width: 120px;
    height: 44px;
    visible: false;
    ignore_event: true;
    stroke: 1;
    back_color: #252735ff;
    #bmm_setting_file_card_label_0:label {
      @"asset/base/style/main#bold_label";
      width: 120px;
      height: 44px;
      size: 11;
      line_height: 15;
      align_x: Center;
      align_y: Center;
      text: "-";
    }
    #native_file_card_hitbox:button {
      width: 100%;
      height: 100%;
      ignore_event: false;
      source: "";
      color: #00000000;
      hover: { color: #00000000; }
      active: { color: #00000000; }
    }
  }
