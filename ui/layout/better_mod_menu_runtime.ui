        width: 224px;
        height: 41px;
        ignore_event: true;
        stroke: 1;
        back_color: #1d1f2cff;
        #icon:image {
          x: 31px;
          y: 9px;
          width: 24px;
          height: 24px;
          source: "asset/base/ui/icons/steam";
        }
        #label:label {
          @"asset/base/style/main#bold_label";
          x: 59px;
          width: 134px;
          height: 41px;
          size: 16;
          color: #e8e8ebff;
          align_x: Left;
          align_y: Center;
          text: "Steam Workshop";
        }
      }

      #bmm_close_menu_button:color {
        x: 510px;
        y: 51px;
        width: 224px;
        height: 41px;
        ignore_event: true;
        stroke: 1;
        back_color: #1d1f2cff;
        #label:label {
          @"asset/base/style/main#bold_label";
          width: 224px;
          height: 41px;
          size: 16;
          align_x: Center;
          align_y: Center;
          text: "Close";
        }
      }

    }

  }

  #bmm_native_layout_donors:empty {
    visible: false;

    #bmm_donor_header:empty {
      x: 24px;
      y: 24px;
      width: 1484px;
      height: 44px;
    }
    #bmm_donor_title:label {
      x: 0px;
      y: 0px;
      width: 734px;
      height: 34px;
    }
    #bmm_donor_table:empty {
      y: 52px;
      width: 734px;
      height: 650px;
    }
    #bmm_donor_table_header:empty {
      width: 734px;
      height: 40px;
    }
    #bmm_donor_table_name:label {
      x: 12px;
      width: 256px;
      height: 40px;
    }
    #bmm_donor_table_author:label {
      x: 268px;
      width: 154px;
      height: 40px;
    }
    #bmm_donor_table_status:label {
      x: 508px;
      width: 214px;
      height: 40px;
    }
    #bmm_donor_table_scroll:scroll_view {
      y: 40px;
      width: 734px;
      height: 610px;
    }
    #bmm_donor_thumbnail_panel:color {
      width: 120px;
      height: 120px;
    }
    #bmm_donor_info_panel:color {
      x: 134px;
      width: 600px;
      height: 120px;
    }
    #bmm_donor_mod_name:label {
      x: 16px;
      y: 12px;
      width: 568px;
      height: 32px;
    }
    #bmm_donor_mod_author:label {
      x: 42px;
      y: 48px;
      width: 278px;
      height: 24px;
    }
    #bmm_donor_mod_date:label {
      x: 42px;
      y: 76px;
      width: 178px;
      height: 24px;
    }
    #bmm_donor_description_panel:color {
      y: 134px;
      width: 734px;
      height: 568px;
    }
    #bmm_donor_description_scroll:scroll_view {
      x: 16px;
      y: 48px;
      width: 702px;
      height: 504px;
    }
    #bmm_donor_bottom_buttons:empty {
      anchor_x: 1;
      pivot_x: 1;
      anchor_y: 1;
      pivot_y: 1;
      x: -24px;
      y: -24px;
      width: 416px;
      height: 40px;
      child_type: LeftToRight {
        spacing: 16px;
      }
    }
  }
}
