bmm_surface:color {
  width: 1532px;
  height: 886px;
  z: 100;
  ignore_event: true;

  color: #161721ff;
  rounding: Uniform {
    rounding: 12;
  }

  #bmm_header:empty {
    x: 24px;
    y: 24px;
    width: 1484px;
    height: 44px;
    ignore_event: true;

    #bmm_title:label {
      @"asset/base/style/main#bold_label";
      x: 0px;
      y: 0px;
      width: 734px;
      height: 28px;
      size: 20;
      align_x: Left;
      align_y: Center;
      text: "Better Mod Menu";
    }

    #bmm_mod_count_summary:label {
      @"asset/base/style/main#label";
      x: 0px;
      y: 24px;
      width: 734px;
      height: 20px;
      size: 13;
      font: "asset/base/font/set/regular";
      align_x: Left;
      align_y: Center;
      text: "Installed mod overview";
    }

  }

  #bmm_menu_grid:empty {
    x: 24px;
    y: 68px;
    width: 1484px;
    height: 702px;
    ignore_event: true;

    #bmm_library_panel:empty {
      x: 0px;
      y: 0px;
      width: 734px;
      height: 702px;
      ignore_event: true;

      #bmm_search_input:text_edit {
        x: 0px;
        y: 0px;
        width: 404px;
        height: 40px;
        ignore_event: false;
        stroke: 1;
        font: "asset/base/font/set/regular";
        size: 14;
        placeholder: "Search by mod or author";
        align_y: Center;
        max_length: 64;
        rounding: Uniform {
          rounding: 8;
        }
        padding: {
          left: 42px;
          right: 42px;
          top: 4px;
          bottom: 4px;
        }
      }

      #bmm_search_icon:image {
        x: 14px;
        y: 12px;
        width: 16px;
        height: 16px;
        ignore_event: true;
        source: "asset/base/ui/banpick/fi-rr-search";
      }

      #bmm_search_clear:button {
        x: 398px;
        y: 13px;
        width: 14px;
        height: 14px;
        visible: false;
        ignore_event: false;
        source: "asset/base/ui/icons/cross";
      }

      #bmm_filter_all:color {
        x: 416px;
        y: 0px;
        width: 92px;
        height: 40px;
        ignore_event: true;
        #label:label {
          @"asset/base/style/main#bold_label";
          width: 100%;
          height: 100%;
          size: 14;
          align_x: Center;
          align_y: Center;
          text: "All";
        }
        #native_filter_hitbox:button {
          width: 100%;
          height: 100%;
          ignore_event: false;
          source: "";
          color: #00000000;
          hover: { color: #00000000; }
          active: { color: #00000000; }
        }
      }

