      width: 100%;
      height: 100%;
      size: 14;
      align_x: Center;
      align_y: Center;
      text: "All";
    }
    #native_filter_hitbox:button {
      width: 100%;
      height: 100%;
      ignore_event: false;
      source: "";
      color: #00000000;
      hover: { color: #00000000; }
      active: { color: #00000000; }
    }
  }

