better_mod_menu_surface:color {
  width: 1532px;
  height: 886px;
  z: 100;
  ignore_event: true;

  color: #161721ff;
  rounding: Uniform {
    rounding: 12;
  }

  #owned_title:label {
    @"asset/base/style/main#bold_label";
    x: 24px;
    y: 12px;
    width: 480px;
    height: 28px;
    size: 20;
    align_x: Left;
    align_y: Center;
    text: "Better Mod Menu";
  }

  #owned_summary:label {
    @"asset/base/style/main#label";
    x: 24px;
    y: 38px;
    width: 760px;
    height: 20px;
    size: 13;
    font: "asset/base/font/set/regular";
    align_x: Left;
    align_y: Center;
    text: "Installed mod overview";
  }

  #owned_cancel:button {
    x: 1492px;
    y: 20px;
    width: 16px;
    height: 16px;
    ignore_event: true;
    source: "asset/base/ui/icons/cross";
    color: #c2c6ceff;
  }

  #mod_menu_search:text_edit {
    x: 24px;
    y: 68px;
    width: 440px;
    height: 40px;
    ignore_event: false;
    stroke: 1;
    font: "asset/base/font/set/regular";
    size: 14;
    placeholder: "Search by mod or author";
    align_y: Center;
    max_length: 64;
    rounding: Uniform {
      rounding: 8;
    }
    padding: {
      left: 42px;
      right: 42px;
      top: 4px;
      bottom: 4px;
    }
  }

  #owned_search_icon:image {
    x: 38px;
    y: 80px;
    width: 16px;
    height: 16px;
    ignore_event: true;
    source: "asset/base/ui/banpick/fi-rr-search";
  }

  #mod_menu_search_clear:button {
    x: 434px;
    y: 81px;
    width: 14px;
    height: 14px;
    visible: false;
    ignore_event: false;
    source: "asset/base/ui/icons/cross";
  }

  #mod_menu_filter_all:color {
