{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/MadManPetr1/tfm2-better-mod-menu/main/better_mod_menu.schema.json",
  "title": "Better Mod Menu manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mod_id", "name", "controls"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "mod_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "storage": { "enum": ["mod", "game_data"], "default": "mod" },
    "settings_file": { "type": "string", "minLength": 1, "default": "settings.json" },
    "actions_file": {
      "type": "string",
      "minLength": 1,
      "default": "better_mod_menu.actions.json"
    },
    "summary": { "type": "string" },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/toggle" },
          { "$ref": "#/$defs/choice" },
          { "$ref": "#/$defs/button" },
          { "$ref": "#/$defs/fileCards" }
        ]
      }
    }
  },
  "$defs": {
    "baseControl": {
      "type": "object",
      "required": ["type", "label"],
      "properties": {
        "type": { "type": "string" },
        "label": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "toggle": {
      "allOf": [
        { "$ref": "#/$defs/baseControl" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "key", "label"],
          "properties": {
            "type": { "const": "toggle" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "category": { "type": "string" },
            "description": { "type": "string" },
            "default": { "type": "boolean", "default": false }
          }
        }
      ]
    },
    "choice": {
      "allOf": [
        { "$ref": "#/$defs/baseControl" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "key", "label", "options"],
          "properties": {
            "type": { "const": "choice" },
            "key": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "category": { "type": "string" },
            "description": { "type": "string" },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string", "minLength": 1 },
                  "value": {}
                }
              }
            }
          }
        }
      ]
    },
    "button": {
      "allOf": [
        { "$ref": "#/$defs/baseControl" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "action", "label"],
          "properties": {
            "type": { "const": "button" },
            "action": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "category": { "type": "string" },
            "description": { "type": "string" },
            "button_label": { "type": "string", "default": "Run" }
          }
        }
      ]
    },
    "fileCards": {
      "allOf": [
        { "$ref": "#/$defs/baseControl" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "action", "label", "directory"],
          "properties": {
            "type": { "const": "file_cards" },
            "action": { "type": "string", "minLength": 1 },
            "label": { "type": "string", "minLength": 1 },
            "category": { "type": "string" },
            "description": { "type": "string" },
            "directory": { "type": "string", "minLength": 1 },
            "filename_contains": { "type": "string" },
            "extension": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 5, "default": 5 }
          }
        }
      ]
    }
  }
}
